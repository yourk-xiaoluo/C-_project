<Window x:Class="WpfApp3.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重置密码" Height="650" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#FF9800" Padding="18">
            <TextBlock Text="重置密码" FontSize="24" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- 重置密码表单 -->
        <Border Grid.Row="1" Margin="30,20,30,20" CornerRadius="8"
                Background="White" Padding="25">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="用户名" FontSize="14" Margin="0,0,0,6" Foreground="#333"/>
                    <TextBox x:Name="TxtUsername" FontSize="14" Padding="10,8"
                             BorderBrush="#CCC" BorderThickness="1"/>

                    <TextBlock Text="注册邮箱" FontSize="14" Margin="0,15,0,6" Foreground="#333"/>
                    <TextBox x:Name="TxtEmail" FontSize="14" Padding="10,8"
                             BorderBrush="#CCC" BorderThickness="1"/>

                    <TextBlock Text="新密码" FontSize="14" Margin="0,15,0,6" Foreground="#333"/>
                    <PasswordBox x:Name="TxtNewPassword" FontSize="14" Padding="10,8"
                                 BorderBrush="#CCC" BorderThickness="1"/>

                    <TextBlock Text="确认新密码" FontSize="14" Margin="0,15,0,6" Foreground="#333"/>
                    <PasswordBox x:Name="TxtConfirmPassword" FontSize="14" Padding="10,8"
                                 BorderBrush="#CCC" BorderThickness="1"/>

                    <!-- 状态提示 -->
                    <TextBlock x:Name="TxtMessage" FontSize="13"
                               Foreground="Red" Margin="0,12,0,0"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="Collapsed"/>

                    <!-- 重置按钮 -->
                    <Button x:Name="BtnReset" Content="重置密码"
                            Height="42" Margin="0,20,0,0" FontSize="16" FontWeight="Bold"
                            Foreground="White" Background="#FF9800" BorderThickness="0"
                            Cursor="Hand" Click="BtnReset_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F57C00"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#E65100"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 返回登录按钮 -->
                    <Button Content="← 返回登录" Margin="0,15,0,0"
                            Height="36" FontSize="14"
                            Foreground="#2196F3" Background="Transparent"
                            BorderBrush="#2196F3" BorderThickness="1"
                            Cursor="Hand" Click="LinkBackToLogin_Click"
                            HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#BBDEFB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>