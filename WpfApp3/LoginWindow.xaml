<Window x:Class="WpfApp3.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户登录" Height="420" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15">
            <TextBlock Text="用户登录" FontSize="24" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- 登录表单 -->
        <Border Grid.Row="1" Margin="35,25,35,25" CornerRadius="8"
                Background="White" Padding="25">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="用户名" FontSize="13" Margin="0,0,0,5" Foreground="#333"/>
                <TextBox x:Name="TxtUsername" FontSize="14" Padding="8,6"
                         BorderBrush="#CCC" BorderThickness="1"/>

                <TextBlock Text="密码" FontSize="13" Margin="0,12,0,5" Foreground="#333"/>
                <PasswordBox x:Name="TxtPassword" FontSize="14" Padding="8,6"
                             BorderBrush="#CCC" BorderThickness="1"/>

                <CheckBox x:Name="ChkRemember" Content="记住密码"
                          Margin="0,8,0,0" FontSize="12" Foreground="#555"/>

                <Button x:Name="BtnLogin" Content="登  录"
                        Height="38" Margin="0,18,0,0" FontSize="15" FontWeight="Bold"
                        Foreground="White" Background="#2196F3" BorderThickness="0"
                        Cursor="Hand" Click="BtnLogin_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1E88E5"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#1976D2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 状态提示 -->
                <TextBlock x:Name="TxtMessage" FontSize="12"
                           Foreground="Red" Margin="0,8,0,0"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="Collapsed"/>

                <!-- 注册和忘记密码链接 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock>
                        <Hyperlink Click="LinkRegister_Click" Foreground="#2196F3" FontSize="12">
                            注册账号
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="  |  " Foreground="#CCC" FontSize="12"/>
                    <TextBlock>
                        <Hyperlink Click="LinkResetPassword_Click" Foreground="#2196F3" FontSize="12">
                            忘记密码
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>