<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图书管理系统" Height="680" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 借出图书变灰的样式 -->
        <Style x:Key="BookCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <DockPanel Grid.Row="0" Background="#1565C0" LastChildFill="False">
            <TextBlock Text="📚 图书管理系统" FontSize="22" FontWeight="Bold"
                       Foreground="White" Margin="20,14,0,14"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtWelcome" FontSize="14"
                       Foreground="#B3D4FC" Margin="15,14,0,14"
                       VerticalAlignment="Center"/>
            <Button Content="退出登录" DockPanel.Dock="Right"
                    Margin="0,10,15,10" Padding="15,6"
                    Foreground="White" Background="Transparent"
                    BorderBrush="White" BorderThickness="1"
                    Cursor="Hand" Click="BtnLogout_Click"
                    FontSize="13"/>
            <Button Content="+ 录入新书" DockPanel.Dock="Right"
                    Margin="0,10,10,10" Padding="15,6"
                    Foreground="White" Background="#4CAF50"
                    BorderThickness="0"
                    Cursor="Hand" Click="BtnAddBook_Click"
                    FontSize="13" FontWeight="Bold"/>
        </DockPanel>

        <!-- 分类筛选栏 -->
        <Border Grid.Row="1" Background="White" Padding="12,8"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="分类筛选：" FontSize="14" Foreground="#555"
                           VerticalAlignment="Center" Margin="5,0,10,0"/>
                <ComboBox x:Name="CmbCategory" Width="140" FontSize="14"
                          SelectionChanged="CmbCategory_SelectionChanged"
                          SelectedIndex="0"/>
                <TextBlock x:Name="TxtBookCount" FontSize="13" Foreground="#888"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 图书列表 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="12">
            <WrapPanel x:Name="BookPanel" Orientation="Horizontal"
                       HorizontalAlignment="Left"/>
        </ScrollViewer>

        <!-- 录入新书弹窗 -->
        <Popup x:Name="AddBookPopup" Placement="Center" AllowsTransparency="True"
               IsOpen="False" StaysOpen="False">
                    <Border Background="White" Padding="25"
                            Width="400" BorderBrush="#CCC" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="录入新图书" FontSize="20" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,0,18"/>

                    <TextBlock Text="书名" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewTitle" FontSize="14" Padding="8,6"
                             BorderBrush="#CCC" BorderThickness="1" Margin="0,0,0,10"/>

                    <TextBlock Text="作者" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewAuthor" FontSize="14" Padding="8,6"
                             BorderBrush="#CCC" BorderThickness="1" Margin="0,0,0,10"/>

                    <TextBlock Text="ISBN" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewISBN" FontSize="14" Padding="8,6"
                             BorderBrush="#CCC" BorderThickness="1" Margin="0,0,0,10"/>

                    <TextBlock Text="分类" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbNewCategory" FontSize="14" Padding="8,4"
                              Margin="0,0,0,15"/>

                    <TextBlock x:Name="TxtAddMessage" FontSize="12" Foreground="Red"
                               Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Width="80" Height="34" FontSize="14"
                                Margin="0,0,10,0" Cursor="Hand" Click="BtnCancelAdd_Click"
                                Background="#E0E0E0" BorderThickness="0" Foreground="#333"/>
                        <Button Content="确定录入" Width="100" Height="34" FontSize="14"
                                FontWeight="Bold" Cursor="Hand" Click="BtnConfirmAdd_Click"
                                Background="#4CAF50" BorderThickness="0" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 借阅弹窗 -->
        <Popup x:Name="BorrowPopup" Placement="Center" AllowsTransparency="True"
               IsOpen="False" StaysOpen="False">
                    <Border Background="White" Padding="25"
                            Width="350" BorderBrush="#CCC" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="借阅图书" FontSize="20" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtBorrowBookInfo" FontSize="14"
                               Foreground="#555" Margin="0,0,0,15" TextWrapping="Wrap"/>

                    <TextBlock Text="借阅人" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBorrower" FontSize="14" Padding="8,6"
                             BorderBrush="#CCC" BorderThickness="1" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Width="80" Height="34" FontSize="14"
                                Margin="0,0,10,0" Cursor="Hand" Click="BtnCancelBorrow_Click"
                                Background="#E0E0E0" BorderThickness="0" Foreground="#333"/>
                        <Button Content="确认借阅" Width="100" Height="34" FontSize="14"
                                FontWeight="Bold" Cursor="Hand" Click="BtnConfirmBorrow_Click"
                                Background="#2196F3" BorderThickness="0" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>